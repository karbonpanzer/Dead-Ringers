<?xml version='1.0' encoding='utf-8'?>
<Defs>

  <!-- Champion -->
  <ThingDef ParentName="ArmorMachineableBase">
    <defName>UFR_ChampionCarapaceArmor</defName>
    <label>Champion Carapace Armor</label>
    <description>A Carapace armor set woven through with psychic-focusing threads and neural-assist relays. Worn by command psycasters, it lets the wearer shed neural heat faster and hold a larger charge before overload, at the cost of the raw protection of a dedicated combat set.</description>
    <graphicData>
      <texPath>UFR/Things/Pawn/Humanlike/Armor/CommanderCarapaceArmor/CommanderCarapaceArmor</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
    </graphicData>
    <colorGenerator Class="ColorGenerator_Options">
      <options>
        <li>
          <weight>10</weight>
          <only>(0.9,0.9,0.9)</only>
        </li>
        <li>
          <weight>10</weight>
          <only>(0.33,0.33,0.33)</only>
        </li>
        <li>
          <weight>10</weight>
          <only>(0.65,0.65,0.65)</only>
        </li>
      </options>
    </colorGenerator>
    <recipeMaker>
      <researchPrerequisite>UFR_ChampionCarapaceArmor</researchPrerequisite>
      <unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
      <skillRequirements>
        <Crafting>7</Crafting>
      </skillRequirements>
      <recipeUsers Inherit="False">
        <li>FabricationBench</li>
      </recipeUsers>
    </recipeMaker>
    <costList>
      <Steel>60</Steel>
      <Plasteel>40</Plasteel>
      <ComponentIndustrial>3</ComponentIndustrial>
      <Gold>30</Gold>
    </costList>
    <statBases>
      <WorkToMake>52000</WorkToMake>
      <MaxHitPoints>320</MaxHitPoints>
      <Mass>8</Mass>
      <Flammability>0.4</Flammability>
      <ArmorRating_Sharp>0.94</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.42</ArmorRating_Blunt>
      <ArmorRating_Heat>0.52</ArmorRating_Heat>
      <Insulation_Cold>34</Insulation_Cold>
      <Insulation_Heat>10</Insulation_Heat>
      <EquipDelay>6</EquipDelay>
    </statBases>
    <equippedStatOffsets>
      <SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">-0.2</SlaveSuppressionOffset>
      <PsychicEntropyMax MayRequire="Ludeon.RimWorld.Royalty">15</PsychicEntropyMax>
      <PsychicEntropyRecoveryRate MayRequire="Ludeon.RimWorld.Royalty">0.025</PsychicEntropyRecoveryRate>
    </equippedStatOffsets>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Neck</li>
        <li>Shoulders</li>
        <li>Arms</li>
        <li>Legs</li>
      </bodyPartGroups>
      <shellRenderedBehindHead>True</shellRenderedBehindHead>
      <layers>
        <li>Middle</li>
        <li>Shell</li>
      </layers>
      <defaultOutfitTags>
        <li>Soldier</li>
      </defaultOutfitTags>
      <wornGraphicPath>UFR/Things/Pawn/Humanlike/Armor/CommanderCarapaceArmor/CommanderCarapaceArmor</wornGraphicPath>
      <useWornGraphicMask>true</useWornGraphicMask>
      <tags Inherit="False">
        <li>UFR_Armor</li>
      </tags>
    </apparel>
    <techLevel>Spacer</techLevel>
    <thingCategories>
      <li>ApparelArmor</li>
    </thingCategories>
    <tradeTags>
      <li>Armor</li>
      <li>UFR_Armor</li>
    </tradeTags>
  </ThingDef>

