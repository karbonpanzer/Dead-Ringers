<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="ApparelBase">
    <defName>UFR_BarrierBelt</defName>
    <label>thermal barrier belt</label>
    <description>A projectile-repulsion device rebuilt around a thermal dispersion layer. Conventional shield belts stop bullets and shrapnel but let fire and heat pass straight through. This one catches them, and the field is tuned loosely enough that the wearer can still shoot out through it.\n\nBoth concessions cost capacity. The barrier holds far less charge than a standard belt and collapses under any concentrated hit, but it recovers almost instantly between them. Once broken it takes a long minute to reform. It shuts down immediately if struck by EMP.</description>
    <thingClass>Apparel</thingClass>
    <techLevel>Spacer</techLevel>
    <tickerType>Normal</tickerType>
    <graphicData>
      <texPath>Things/Pawn/Humanlike/Apparel/ShieldBelt/ShieldBelt</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <Mass>3</Mass>
      <WorkToMake>16000</WorkToMake>
      <Flammability>0.4</Flammability>
      <EnergyShieldEnergyMax>0.35</EnergyShieldEnergyMax>
      <EnergyShieldRechargeRate>0.30</EnergyShieldRechargeRate>
      <EquipDelay>2</EquipDelay>
    </statBases>
    <costList>
      <ComponentIndustrial>2</ComponentIndustrial>
      <Steel>50</Steel>
      <Plasteel>25</Plasteel>
    </costList>
    <recipeMaker>
      <unfinishedThingDef>UnfinishedBelt</unfinishedThingDef>
      <researchPrerequisite>UFR_ThermalDispersion</researchPrerequisite>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <effectWorking>Smith</effectWorking>
      <soundWorking>Recipe_Machining</soundWorking>
      <recipeUsers>
        <li>TableMachining</li>
      </recipeUsers>
      <useIngredientsForColor>false</useIngredientsForColor>
      <skillRequirements>
        <Crafting>7</Crafting>
      </skillRequirements>
      <displayPriority>301</displayPriority>
    </recipeMaker>
    <thingCategories>
      <li>ApparelUtility</li>
    </thingCategories>
    <apparel>
      <countsAsClothingForNudity>false</countsAsClothingForNudity>
      <careIfWornByCorpse>false</careIfWornByCorpse>
      <careIfDamaged>false</careIfDamaged>
      <wearPerDay>0</wearPerDay>
      <bodyPartGroups>
        <li>Waist</li>
      </bodyPartGroups>
      <layers>
        <li>Belt</li>
      </layers>
      <tags>
        <li>BeltDefense</li>
      </tags>
      <developmentalStageFilter>Child, Adult</developmentalStageFilter>
    </apparel>
    <comps>
      <li Class="UnitedFront.Comps.CompProperties_ShieldUFR">
        <bubbleTexPath>Things/Other/UFRShield</bubbleTexPath>
        <randomizeRotation>true</randomizeRotation>
        <lowEnergyPulseThreshold>0.25</lowEnergyPulseThreshold>
        <blocksRangedWeapons>false</blocksRangedWeapons>
        <blocksExplosiveDamage>true</blocksExplosiveDamage>
        <energyLossPerDamage>0.01</energyLossPerDamage>
        <startingTicksToReset>3600</startingTicksToReset>
        <energyOnReset>0.1</energyOnReset>
        <minDrawSize>2.00</minDrawSize>
        <maxDrawSize>2.90</maxDrawSize>
        <breakFlashScale>2.0</breakFlashScale>
        <breakDustPuffs>0</breakDustPuffs>
        <breakEffecterScale>1.0</breakEffecterScale>
        <extraBlockedDamageDefs>
          <li>Flame</li>
          <li>Burn</li>
        </extraBlockedDamageDefs>
      </li>
    </comps>
    <colorGenerator Class="ColorGenerator_Options">
      <options>
        <li>
          <weight>10</weight>
          <only>(0.33,0.33,0.33,1)</only>
        </li>
        <li>
          <weight>10</weight>
          <only>(0.65,0.65,0.65,1)</only>
        </li>
        <li>
          <weight>6</weight>
          <min>(0.3,0.3,0.3,1)</min>
          <max>(0.5,0.5,0.5,1)</max>
        </li>
        <li>
          <weight>10</weight>
          <only>(0.9,0.9,0.9,1)</only>
        </li>
      </options>
    </colorGenerator>
    <tradeTags>
      <li>Armor</li>
    </tradeTags>
    <allowedArchonexusCount>1</allowedArchonexusCount>
  </ThingDef>

</Defs>