    <apparel>
      <bodyPartGroups>
        <li>UpperHead</li>
      </bodyPartGroups>
      <wornGraphicPath>UFR/Things/Pawn/Humanlike/Headgear/OfficerCap/OfficerCap</wornGraphicPath>
      <useWornGraphicMask>True</useWornGraphicMask>
      <layers>
        <li>Overhead</li>
      </layers>
      <tags>
        <li>UFR_OfficerUniform</li>
      </tags>
      <defaultOutfitTags>
        <li>Soldier</li>
      </defaultOutfitTags>
      <countsAsClothingForNudity>false</countsAsClothingForNudity>
      <canBeDesiredForIdeo>true</canBeDesiredForIdeo>
      <canBeGeneratedToSatisfyWarmth>false</canBeGeneratedToSatisfyWarmth>
    </apparel>
    <techLevel>Industrial</techLevel>
    <thingCategories Inherit="False">
      <li>UFR_Headgear</li>
    </thingCategories>
    <tradeTags>
      <li>Clothing</li>
      <li>UFR_Uniforms</li>
    </tradeTags>
    <uiIconScale>1.15</uiIconScale>
  </ThingDef>

