<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <ThingDef ParentName="ApparelMakeableBase">
    <defName>UFR_Webbing_Infantry</defName>
    <label>Infantry Webbing</label>
    <description>A standard load-bearing harness worn by Outcast infantry. Distributes the weight of ammunition and field kit across the torso. Issued to most front-line personnel.</description>
    <graphicData>
      <texPath>UFR/Things/Pawn/Humanlike/Accessories/FrontInfantryWebbing/FrontInfantryWebbing</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <colorGenerator Class="ColorGenerator_Single">
      <color>(0.35,0.35,0.35)</color>
    </colorGenerator>
    <recipeMaker>
      <researchPrerequisite>UFR_StandardizedInfantryKits</researchPrerequisite>
    </recipeMaker>
    <costList>
      <Steel>40</Steel>
      <Cloth>40</Cloth>
    </costList>
    <stuffCategories Inherit="False" IsNull="True" />
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <WorkToMake>2000</WorkToMake>
      <Mass>1</Mass>
      <EquipDelay>1.5</EquipDelay>
    </statBases>
    <equippedStatOffsets>
      <RangedCooldownFactor>-0.10</RangedCooldownFactor>
    </equippedStatOffsets>
    <apparel>
      <drawData>
        <dataSouth>
          <layer>21.5</layer>
        </dataSouth>
        <dataWest>
          <layer>21.5</layer>
        </dataWest>
        <dataEast>
          <layer>21.5</layer>
        </dataEast>
        <dataNorth>
          <layer>21.5</layer>
        </dataNorth>
      </drawData>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Waist</li>
      </bodyPartGroups>
      <wornGraphicPath>UFR/Things/Pawn/Humanlike/Accessories/FrontInfantryWebbing/FrontInfantryWebbing</wornGraphicPath>
      <wornGraphicData>
      <renderUtilityAsPack>false</renderUtilityAsPack>
      </wornGraphicData>
      <layers>
        <li>Belt</li>
      </layers>
      <tags>
        <li>UFR_Webbing_Infantry</li>
        <li>UFR_Accessories</li>
      </tags>
      <defaultOutfitTags>
        <li>Soldier</li>
      </defaultOutfitTags>
      <canBeDesiredForIdeo>false</canBeDesiredForIdeo>
    </apparel>
    <thingCategories>
      <li>UFR_Accessories</li>
    </thingCategories>
    <tradeTags>
      <li>Clothing</li>
      <li>UFR_Uniforms</li>
    </tradeTags>
  </ThingDef>

