  <ThingDef ParentName="ApparelMakeableBase">
    <defName>UFR_Webbing_Assault</defName>
    <label>Assault Webbing</label>
    <description>A load-bearing harness configured for close-quarters assault. High-capacity magazine pouches and breach tool loops sit alongside dedicated grenade retention, positioned for fast access under fire.</description>
    <graphicData>
      <texPath>UFR/Things/Pawn/Humanlike/Accessories/ShocktrooperWebbing/ShocktrooperWebbing</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <colorGenerator Class="ColorGenerator_Single">
      <color>(0.35,0.35,0.35)</color>
    </colorGenerator>
    <recipeMaker>
      <researchPrerequisite>UFR_ModifiedSpecialistKits</researchPrerequisite>
    </recipeMaker>
    <costList>
      <Steel>40</Steel>
      <Cloth>40</Cloth>
    </costList>
    <stuffCategories Inherit="False" IsNull="True" />
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <WorkToMake>6000</WorkToMake>
      <Mass>1</Mass>
      <EquipDelay>1</EquipDelay>
    </statBases>
    <equippedStatOffsets>
      <MeleeDamageFactor>0.10</MeleeDamageFactor>
      <MeleeCooldownFactor>-0.05</MeleeCooldownFactor>
      <PainShockThreshold>0.10</PainShockThreshold>
    </equippedStatOffsets>
    <apparel>
      <drawData>
        <dataSouth>
          <layer>21.5</layer>
        </dataSouth>
        <dataWest>
          <layer>21.5</layer>
        </dataWest>
        <dataEast>
          <layer>21.5</layer>
        </dataEast>
        <dataNorth>
          <layer>21.5</layer>
        </dataNorth>
      </drawData>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Shoulders</li>
        <li>Waist</li>
      </bodyPartGroups>
      <wornGraphicPath>UFR/Things/Pawn/Humanlike/Accessories/ShocktrooperWebbing/ShocktrooperWebbing</wornGraphicPath>
      <wornGraphicData>
        <renderUtilityAsPack>false</renderUtilityAsPack>
      </wornGraphicData>
      <layers>
        <li>Shell</li>
      </layers>
      <tags>
        <li>UFR_Webbing_Assault</li>
        <li>UFR_Accessories</li>
      </tags>
      <defaultOutfitTags>
        <li>Soldier</li>
      </defaultOutfitTags>
      <canBeDesiredForIdeo>false</canBeDesiredForIdeo>
    </apparel>
    <verbs>
      <li>
        <label>throw frag grenade</label>
        <verbClass>Verb_LaunchProjectileStatic</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <onlyManualCast>True</onlyManualCast>
        <range>12.9</range>
        <forcedMissRadius>1.9</forcedMissRadius>
        <warmupTime>1.5</warmupTime>
        <noiseRadius>4</noiseRadius>
        <ai_IsBuildingDestroyer>true</ai_IsBuildingDestroyer>
        <soundCast>ThrowGrenade</soundCast>
        <drawHighlightWithLineOfSight>true</drawHighlightWithLineOfSight>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
        <defaultProjectile>Proj_GrenadeFrag</defaultProjectile>
        <rangedFireRulepack>Combat_RangedFire_Thrown</rangedFireRulepack>
      </li>
    </verbs>
    <comps>
      <li Class="CompProperties_ApparelReloadable">
        <maxCharges>8</maxCharges>
        <ammoDef>Weapon_GrenadeFrag</ammoDef>
        <ammoCountToRefill>1</ammoCountToRefill>
        <baseReloadTicks>60</baseReloadTicks>
        <soundReload>Standard_Reload</soundReload>
        <hotKey>Misc4</hotKey>
        <chargeNoun>frag</chargeNoun>
        <displayGizmoWhileUndrafted>false</displayGizmoWhileUndrafted>
      </li>
    </comps>
    <thingCategories>
      <li>UFR_Accessories</li>
    </thingCategories>
    <tradeTags>
      <li>Clothing</li>
      <li>UFR_Uniforms</li>
    </tradeTags>
    <uiIconScale>1.15</uiIconScale>
  </ThingDef>
</Defs>