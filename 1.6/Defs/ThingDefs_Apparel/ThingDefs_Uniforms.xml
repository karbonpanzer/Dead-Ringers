<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Infantry Clothing -->
  <ThingDef ParentName="ApparelMakeableBase">
    <defName>UFR_InfantryUniform</defName>
    <label>Infantry Uniform</label>
    <description>The standard duty uniform, built to hold up across every posting the Front takes. Layered weave regulates heat in both directions, letting a single pattern serve from tundra to desert.</description>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>UFR/Things/Pawn/Humanlike/Clothes/FieldUniform/FieldUniform</texPath>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>1.5</drawSize>
    </graphicData>
    <colorGenerator Class="ColorGenerator_Options">
      <options>
        <li>
          <weight>10</weight>
          <only>(0.45,0.42,0.30)</only>
        </li>
        <li>
          <weight>8</weight>
          <only>(0.38,0.40,0.30)</only>
        </li>
        <li>
          <weight>10</weight>
          <only>(0.35,0.33,0.22)</only>
        </li>
        <li>
          <weight>8</weight>
          <only>(0.30,0.32,0.20)</only>
        </li>
      </options>
    </colorGenerator>
    <recipeMaker>
      <researchPrerequisite>UFR_AdvancedWovenUniforms</researchPrerequisite>
    </recipeMaker>
    <stuffCategories>
      <li>Fabric</li>
      <li>Leathery</li>
    </stuffCategories>
    <costStuffCount>75</costStuffCount>
    <statBases>
      <MaxHitPoints>250</MaxHitPoints>
      <WorkToMake>4200</WorkToMake>
      <Mass>1.8</Mass>
      <StuffEffectMultiplierArmor>0.12</StuffEffectMultiplierArmor>
      <StuffEffectMultiplierInsulation_Cold>1.45</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>1.45</StuffEffectMultiplierInsulation_Heat>
      <EquipDelay>2</EquipDelay>
    </statBases>
    <apparel>
      <developmentalStageFilter>Child,Adult</developmentalStageFilter>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Neck</li>
        <li>Shoulders</li>
        <li>Arms</li>
        <li>Legs</li>
      </bodyPartGroups>
      <wornGraphicPath>UFR/Things/Pawn/Humanlike/Clothes/FieldUniform/FieldUniform</wornGraphicPath>
      <useWornGraphicMask>True</useWornGraphicMask>
      <layers>
        <li>OnSkin</li>
      </layers>
      <tags>
        <li>UFR_UFUniform</li>
      </tags>
      <defaultOutfitTags>
        <li>Soldier</li>
      </defaultOutfitTags>
    </apparel>
    <techLevel>Industrial</techLevel>
    <thingCategories Inherit="False">
      <li>UFR_Uniforms</li>
    </thingCategories>
    <tradeTags>
      <li>Clothing</li>
      <li>UFR_Uniforms</li>
    </tradeTags>
    <uiIconScale>1.15</uiIconScale>
  </ThingDef>

  <ThingDef ParentName="HatMakeableBase">
    <defName>UFR_Hat_Ushanka</defName>
    <label>Ushanka</label>
    <description>An insulated fur cap with fold-down ear flaps. Covers the ears without significantly restricting peripheral vision.</description>
    <graphicData>
      <texPath>UFR/Things/Pawn/Humanlike/Headgear/FieldHatWinter/FieldHatWinter</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>1.2</drawSize>
    </graphicData>
    <colorGenerator Class="ColorGenerator_Options">
      <options>
        <li>
          <weight>10</weight>
          <only>(0.35,0.38,0.34)</only>
        </li>
        <li>
          <weight>10</weight>
          <only>(0.40,0.40,0.38)</only>
        </li>
        <li>
          <weight>8</weight>
          <only>(0.30,0.32,0.28)</only>
        </li>
        <li>
          <weight>8</weight>
          <only>(0.38,0.36,0.32)</only>
        </li>
      </options>
    </colorGenerator>
    <recipeMaker>
      <researchPrerequisite>UFR_AdvancedWovenUniforms</researchPrerequisite>
    </recipeMaker>
    <stuffCategories>
