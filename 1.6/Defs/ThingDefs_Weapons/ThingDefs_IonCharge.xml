<Defs>

  <!-- Ion-Charge Pistol -->
  <ThingDef ParentName="BaseBullet">
    <defName>UFR_Bolt_IonChargePistol</defName>
    <label>ion-charge pistol round</label>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>UFR/Things/Projectile/ionchargesmall</texPath>
      <drawSize>0.85</drawSize>
      <shaderType>MoteGlow</shaderType>
    </graphicData>
    <projectile>
      <damageDef>Bullet</damageDef>
      <damageAmountBase>12</damageAmountBase>
      <armorPenetrationBase>0.25</armorPenetrationBase>
      <speed>100</speed>
      <extraDamages>
        <li>
          <def>EMP</def>
          <amount>15</amount>
          <chance>0.2</chance>
        </li>
      </extraDamages>
      <landedEffecter>UFR_EffectImpact_IonCharge</landedEffecter>
    </projectile>
    <!--
    <comps>
      <li Class="CompProperties_ProjectileEffecter">
        <effecterDef>UFR_EffectLaunch_IonCharge</effecterDef>
      </li>
    </comps>
    -->
  </ThingDef>

  <ThingDef ParentName="BaseHumanMakeableGun" Name="UFR_IonChargePistol">
    <defName>UFR_IonChargePistol</defName>
    <label>Ion-Charge Pistol</label>
    <description>A charged-shot handgun. Modified to use ionized gases to coat the pulse-charged munitions. The gases disrupt electronics but dissipate quickly which reduces the effective distance of the weapon.</description>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>UFR/Things/Item/Equipment/ionchargepistol</texPath>
      <drawSize>1.0</drawSize>
    </graphicData>
    <techLevel>Spacer</techLevel>
    <soundInteract>Interact_ChargeRifle</soundInteract>
    <recipeMaker>
      <researchPrerequisite>UFR_IonizedGasMunitions</researchPrerequisite>
      <skillRequirements>
        <Crafting>8</Crafting>
      </skillRequirements>
      <recipeUsers>
        <li>FabricationBench</li>
      </recipeUsers>
    </recipeMaker>
    <costList>
      <Steel>30</Steel>
      <Plasteel>20</Plasteel>
      <ComponentSpacer>4</ComponentSpacer>
    </costList>
    <statBases>
      <WorkToMake>40000</WorkToMake>
      <Mass>1.4</Mass>
      <MarketValue>1600</MarketValue>
      <AccuracyTouch>0.85</AccuracyTouch>
      <AccuracyShort>0.78</AccuracyShort>
      <AccuracyMedium>0.55</AccuracyMedium>
      <AccuracyLong>0.30</AccuracyLong>
      <RangedWeapon_Cooldown>1.4</RangedWeapon_Cooldown>
    </statBases>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>UFR_Bolt_IonChargePistol</defaultProjectile>
        <warmupTime>0.5</warmupTime>
        <range>22</range>
        <burstShotCount>3</burstShotCount>
        <ticksBetweenBurstShots>10</ticksBetweenBurstShots>
        <soundCast>UFR_Bolt_IonCharge</soundCast>
        <soundCastTail>GunTail_Light</soundCastTail>
        <muzzleFlashScale>9</muzzleFlashScale>
      </li>
    </verbs>
    <weaponTags>
      <li>UFR_SpacerGun</li>
      <li>SpacerGun</li>
    </weaponTags>
    <tradeTags>
      <li>UFR_WeaponSpacer</li>
    </tradeTags>
    <tools>
      <li>
        <label>grip</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
      <li>
        <label>barrel</label>
        <capacities>
          <li>Poke</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
  </ThingDef>

