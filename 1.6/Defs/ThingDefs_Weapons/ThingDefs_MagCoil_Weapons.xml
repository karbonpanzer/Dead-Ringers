<?xml version="1.0" encoding="utf-8" ?>
<Defs>
    
    <!-- Coil Rifle -->
    <ThingDef ParentName="BaseBullet">
        <defName>UFR_Slug_CoilRifle</defName>
        <label>coil rifle slug</label>
        <graphicData>
            <graphicClass>Graphic_Single</graphicClass>
            <texPath>Things/Projectile/slug_medium</texPath>
            <drawSize>0.75</drawSize>
            <shaderType>MoteGlow</shaderType>
        </graphicData>
        <projectile>
            <flyOverhead>false</flyOverhead>
            <damageDef>Bullet</damageDef>
            <damageAmountBase>32</damageAmountBase>
            <armorPenetrationBase>0.72</armorPenetrationBase>
            <speed>140</speed>
        <stoppingPower>2.0</stoppingPower>      <landedEffecter>UFR_EffectImpact_CoilGun</landedEffecter>
    </projectile>
    <comps>
      <li Class="CompProperties_ProjectileEffecter">
        <effecterDef>UFR_EffectLaunch_CoilGun</effecterDef>
      </li>
    </comps>
    </ThingDef>

    <ThingDef ParentName="BaseHumanMakeableGun" Name="UFR_CoilRifle">
        <defName>UFR_CoilRifle</defName>
        <label>Coil Rifle</label>
        <description>An advanced coil rifle design used by United Front veterans and mercenaries. Built with state-of-the-art polymers and alloys, it fires powerful armor-piercing tungsten slugs.</description>
        <graphicData>
            <graphicClass>Graphic_Single</graphicClass>
            <texPath>Things/Item/Equipment/coilrifle</texPath>
            <drawSize>1.0</drawSize>
        </graphicData>
        <techLevel>Spacer</techLevel>
        <soundInteract>Interact_ChargeRifle</soundInteract>
        <recipeMaker>
            <researchPrerequisite>UFR_AdvancedCoilFabrication</researchPrerequisite>
            <skillRequirements>
                <Crafting>10</Crafting>
            </skillRequirements>
            <recipeUsers>
                <li>UFR_FabricationBench</li>
            </recipeUsers>
        </recipeMaker>
        <costList>
            <Steel>60</Steel>
            <ComponentIndustrial>4</ComponentIndustrial>
            <ComponentSpacer>5</ComponentSpacer>
            <Plasteel>22</Plasteel>
        </costList>
        <statBases>
            <WorkToMake>56000</WorkToMake>
            <Mass>3.8</Mass>
            <MarketValue>3200</MarketValue>
            <AccuracyTouch>0.52</AccuracyTouch>
            <AccuracyShort>0.78</AccuracyShort>
            <AccuracyMedium>0.82</AccuracyMedium>
            <AccuracyLong>0.72</AccuracyLong>
            <RangedWeapon_Cooldown>2.2</RangedWeapon_Cooldown>
        </statBases>
        <verbs>
            <li>
                <verbClass>Verb_Shoot</verbClass>
                <hasStandardCommand>true</hasStandardCommand>
                <defaultProjectile>UFR_Slug_CoilRifle</defaultProjectile>
                <warmupTime>1.4</warmupTime>
                <range>34.9</range>
                <burstShotCount>1</burstShotCount>
                <ticksBetweenBurstShots>8</ticksBetweenBurstShots>
                <soundCast>UFR_Shot_SlugMedium</soundCast>
                <soundCastTail>GunTail_Medium</soundCastTail>
                <muzzleFlashScale>10</muzzleFlashScale>
            </li>
        </verbs>
        <weaponTags>
            <li>UFR_UFRifle</li>
        </weaponTags>
        <tools>
            <li>
                <label>stock</label>
                <capacities>
                    <li>Blunt</li>
                </capacities>
                <power>12</power>
                <cooldownTime>2</cooldownTime>
            </li>
            <li>
                <label>barrel</label>
                <capacities>
                    <li>Blunt</li>
                    <li>Poke</li>
                </capacities>
                <power>10</power>
                <cooldownTime>2</cooldownTime>
            </li>
        </tools>
        <thingSetMakerTags>
            <li>RewardStandardHighTech</li>
        </thingSetMakerTags>
        <tradeTags>
            <li>WeaponRanged</li>
        </tradeTags>
        <uiIconScale>1.05</uiIconScale>
    </ThingDef>

