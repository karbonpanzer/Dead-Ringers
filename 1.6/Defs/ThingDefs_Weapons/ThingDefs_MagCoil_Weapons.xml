    <ThingDef ParentName="BaseHumanMakeableGun" Name="UFR_TricoilHeavyRifle">
        <defName>UFR_HeavyCoilRifle</defName>
        <label>Heavy Coil Rifle</label>
        <description>An experimental anti-material coil rifle built around three stacked capacitor rails. Heavy and cumbersome, effective against both armored and unarmored targets.</description>
        <graphicData>
            <graphicClass>Graphic_Single</graphicClass>
            <texPath>Things/Item/Equipment/tricoilrifle</texPath>
            <drawSize>1.25</drawSize>
        </graphicData>
        <techLevel>Spacer</techLevel>
        <soundInteract>Interact_ChargeRifle</soundInteract>
        <recipeMaker>
            <researchPrerequisite>UFR_ReinforcedCoilSuperstructures</researchPrerequisite>
            <skillRequirements>
                <Crafting>12</Crafting>
            </skillRequirements>
            <recipeUsers>
                <li>UFR_FabricationBench</li>
            </recipeUsers>
        </recipeMaker>
        <costList>
            <Steel>120</Steel>
            <ComponentIndustrial>8</ComponentIndustrial>
            <ComponentSpacer>8</ComponentSpacer>
            <Plasteel>40</Plasteel>
        </costList>
        <statBases>
            <WorkToMake>76000</WorkToMake>
            <Mass>11.5</Mass>
            <MarketValue>8200</MarketValue>
            <AccuracyTouch>0.40</AccuracyTouch>
            <AccuracyShort>0.58</AccuracyShort>
            <AccuracyMedium>0.78</AccuracyMedium>
            <AccuracyLong>0.82</AccuracyLong>
            <RangedWeapon_Cooldown>4.0</RangedWeapon_Cooldown>
        </statBases>
        <equippedStatOffsets>
            <MoveSpeed>-0.30</MoveSpeed>
        </equippedStatOffsets>
        <verbs>
            <li>
                <verbClass>Verb_Shoot</verbClass>
                <hasStandardCommand>true</hasStandardCommand>
                <defaultProjectile>UFR_Slug_HeavyCoilRifle</defaultProjectile>
                <warmupTime>3.6</warmupTime>
                <range>81.9</range>
                <soundCast>UFR_Shot_SlugBig</soundCast>
                <soundCastTail>GunTail_Heavy</soundCastTail>
                <muzzleFlashScale>13</muzzleFlashScale>
            </li>
        </verbs>
        <weaponTags>
          <li>UFR_UFMarksman</li>
        </weaponTags>
        <tools>
            <li>
                <label>frame</label>
                <capacities>
                    <li>Blunt</li>
                </capacities>
                <power>14</power>
                <cooldownTime>2</cooldownTime>
            </li>
            <li>
                <label>barrels</label>
                <capacities>
                    <li>Poke</li>
                </capacities>
                <power>16</power>
                <cooldownTime>2</cooldownTime>
            </li>
        </tools>
        <thingSetMakerTags>
            <li>RewardHighTech</li>
            <li>RewardUnique</li>
        </thingSetMakerTags>
        <tradeTags>
            <li>WeaponRanged</li>
        </tradeTags>
        <uiIconScale>0.90</uiIconScale>
    </ThingDef>

