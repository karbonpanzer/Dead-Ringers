<Defs>

  <ThingDef ParentName="BaseBullet">
    <defName>UFR_Round_StormPistol</defName>
    <label>storm pistol round</label>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>UFR/Things/Projectile/slug_medium</texPath>
      <drawSize>0.55</drawSize>
      <shaderType>TransparentPostLight</shaderType>
    </graphicData>
    <projectile>
      
      <damageDef>UFR_StormBlast</damageDef>
      <damageAmountBase>12</damageAmountBase>
      <armorPenetrationBase>0.45</armorPenetrationBase>
      <speed>120</speed>
      <stoppingPower>1.5</stoppingPower>
      <landedEffecter>UFR_EffectImpact_CoilGun</landedEffecter>
    </projectile>
