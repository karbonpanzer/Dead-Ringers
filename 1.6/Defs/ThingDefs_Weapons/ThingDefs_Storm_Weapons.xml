  <ThingDef ParentName="BaseHumanMakeableGun" Name="UFR_StormRifle">
    <defName>UFR_StormRifle</defName>
    <label>Storm Rifle</label>
    <description>The Front's standard-issue rifle. It fires self-propelled uranium rounds wrapped in a charge matrix — the motor keeps burning after launch, so the round arrives far harder than its calibre suggests, and wanders on the way. Front armorers accepted the loss of precision as the price of a round that goes through what it hits.</description>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>UFR/Things/Item/Equipment/stormrifle</texPath>
      <drawSize>1.0</drawSize>
      <onGroundRandomRotateAngle>35</onGroundRandomRotateAngle>
    </graphicData>
    <techLevel>Spacer</techLevel>
    <soundInteract>Interact_ChargeRifle</soundInteract>
    <recipeMaker>
      <researchPrerequisite>UFR_MinitureRAPManufacturing</researchPrerequisite>
      <skillRequirements>
        <Crafting>10</Crafting>
      </skillRequirements>
      <recipeUsers>
        <li>FabricationBench</li>
      </recipeUsers>
    </recipeMaker>
    <costList>
      <Plasteel>45</Plasteel>
      <Uranium>20</Uranium>
      <Chemfuel>25</Chemfuel>
      <ComponentSpacer>3</ComponentSpacer>
    </costList>
    <statBases>
      <WorkToMake>56000</WorkToMake>
      <Mass>3.8</Mass>
      <MarketValue>3200</MarketValue>
      <AccuracyTouch>0.45</AccuracyTouch>
      <AccuracyShort>0.62</AccuracyShort>
      <AccuracyMedium>0.68</AccuracyMedium>
      <AccuracyLong>0.55</AccuracyLong>
      <RangedWeapon_Cooldown>1.6</RangedWeapon_Cooldown>
    </statBases>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>UFR_Round_StormRifle</defaultProjectile>
        <warmupTime>1.1</warmupTime>
        <range>32</range>
        <burstShotCount>1</burstShotCount>
        <soundCast>Shot_Autocannon</soundCast>
        <soundCastTail>GunTail_Medium</soundCastTail>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
        <muzzleFlashScale>10</muzzleFlashScale>
      </li>
    </verbs>
    <weaponClasses>
      <li>RangedHeavy</li>
    </weaponClasses>
    <generateCommonality>1.0</generateCommonality>
    <weaponTags>
      <li>UFR_Storm_Rifle</li>
    </weaponTags>
    <tools>
      <li>
        <label>stock</label>
        <capacities><li>Blunt</li></capacities>
        <power>12</power>
        <cooldownTime>2</cooldownTime>
      </li>
      <li>
        <label>barrel</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>10</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
    <thingSetMakerTags>
      <li>RewardStandardHighTech</li>
    </thingSetMakerTags>
    <tradeTags>
      <li>WeaponRanged</li>
    </tradeTags>
    <uiIconScale>1.05</uiIconScale>
  </ThingDef>

