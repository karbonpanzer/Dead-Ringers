  <ThingDef ParentName="BaseHumanMakeableGun">
    <defName>UFR_StormPistol</defName>
    <label>Storm Pistol</label>
    <description>A sidearm that fires self-propelled uranium rounds. The barrel is too short to do more than point the round in roughly the right direction; the motor does the rest, still burning as it crosses the room. Front officers carry one on the understanding that it will miss, and that it will not matter much when it doesn't.</description>
    <techLevel>Spacer</techLevel>
    <soundInteract>Interact_ChargeRifle</soundInteract>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>UFR/Things/Item/Equipment/stormpistol</texPath>
      <drawSize>1.05</drawSize>
      <onGroundRandomRotateAngle>35</onGroundRandomRotateAngle>
    </graphicData>
    <statBases>
      <WorkToMake>32000</WorkToMake>
      <Mass>1.9</Mass>
      <MarketValue>1600</MarketValue>
      <AccuracyTouch>0.62</AccuracyTouch>
      <AccuracyShort>0.55</AccuracyShort>
      <AccuracyMedium>0.35</AccuracyMedium>
      <AccuracyLong>0.15</AccuracyLong>
      <RangedWeapon_Cooldown>1.2</RangedWeapon_Cooldown>
    </statBases>
    <costList>
      <Plasteel>25</Plasteel>
      <Uranium>10</Uranium>
      <Chemfuel>15</Chemfuel>
      <ComponentSpacer>1</ComponentSpacer>
    </costList>
    <recipeMaker>
      <researchPrerequisite>UFR_MinitureRAPManufacturing</researchPrerequisite>
      <skillRequirements>
        <Crafting>8</Crafting>
      </skillRequirements>
      <recipeUsers>
        <li>FabricationBench</li>
      </recipeUsers>
    </recipeMaker>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>UFR_Round_StormPistol</defaultProjectile>
        <warmupTime>0.6</warmupTime>
        <range>21</range>
        <burstShotCount>1</burstShotCount>
        <soundCast>Shot_Autocannon</soundCast>
        <soundCastTail>GunTail_Medium</soundCastTail>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
        <muzzleFlashScale>9</muzzleFlashScale>
      </li>
    </verbs>
    <tools>
      <li>
        <label>grip</label>
        <capacities><li>Blunt</li></capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
      <li>
        <label>barrel</label>
        <capacities><li>Poke</li></capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
    <weaponClasses>
      <li>RangedLight</li>
    </weaponClasses>
    <generateCommonality>1.2</generateCommonality>
    <weaponTags>
      <li>UFR_Storm_Sidearm</li>
    </weaponTags>
    <thingSetMakerTags>
      <li>RewardStandardHighTech</li>
    </thingSetMakerTags>
    <tradeTags>
      <li>WeaponRanged</li>
    </tradeTags>
    <uiIconScale>1.05</uiIconScale>
  </ThingDef>

