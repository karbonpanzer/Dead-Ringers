    <costList>
      <Plasteel>70</Plasteel>
      <Uranium>40</Uranium>
      <Chemfuel>40</Chemfuel>
      <ComponentSpacer>5</ComponentSpacer>
    </costList>
    <statBases>
      <WorkToMake>76000</WorkToMake>
      <Mass>11.5</Mass>
      <MarketValue>8200</MarketValue>
      <AccuracyTouch>0.32</AccuracyTouch>
      <AccuracyShort>0.48</AccuracyShort>
      <AccuracyMedium>0.66</AccuracyMedium>
      <AccuracyLong>0.70</AccuracyLong>
      <RangedWeapon_Cooldown>3.2</RangedWeapon_Cooldown>
