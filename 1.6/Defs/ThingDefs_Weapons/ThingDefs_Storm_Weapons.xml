  <ThingDef ParentName="BaseHumanMakeableGun" Name="UFR_StormCannon">
    <defName>UFR_StormCannon</defName>
    <label>Storm Cannon</label>
    <description>An oversized launcher built around a firing cradle rather than a barrel. Its rounds carry enough uranium and propellant to punch through cataphract plate, but the weapon shakes itself off-line with every launch. Steady hands and long sightlines are the only way to make it pay.</description>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>UFR/Things/Item/Equipment/stormcannon</texPath>
      <drawSize>1.25</drawSize>
