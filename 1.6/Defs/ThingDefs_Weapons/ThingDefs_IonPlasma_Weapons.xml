<?xml version='1.0' encoding='utf-8'?>
<Defs>

  <!-- Plasma Pistol -->
  <ThingDef ParentName="BaseBullet">
    <defName>UFR_Slug_IonPlasmaPistol</defName>
    <label>ion-plasma pistol slug</label>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>UFR/Things/Projectile/plasmabolt</texPath>
      <drawSize>0.85</drawSize>
      <shaderType>MoteGlow</shaderType>
    </graphicData>
    <projectile>
      <flyOverhead>false</flyOverhead>
      <damageDef>Bullet</damageDef>
      <damageAmountBase>22</damageAmountBase>
      <armorPenetrationBase>0.50</armorPenetrationBase>
      <speed>120</speed>
      <extraDamages>
        <li>
          <def>Burn</def>
          <amount>3</amount>
        </li>
      </extraDamages>
          <landedEffecter>UFR_EffectImpact_IonPlasma</landedEffecter>
    </projectile>
    <comps>
      <li Class="CompProperties_ProjectileEffecter">
        <effecterDef>UFR_EffectLaunch_IonPlasma</effecterDef>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="BaseHumanMakeableGun" Name="UFR_IonPlasmaPistol">
    <defName>UFR_IonPlasmaPistol</defName>
    <label>Ion-Plasma Pistol</label>
    <description>An upgraded coil pistol that wraps its uranium slug in a sheath of ionized plasma before launch. The plasma sleeve melts and weakens armor a fraction of a second before the slug arrives, dramatically improving penetration without sacrificing the platform's compactness.</description>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>UFR/Things/Item/Equipment/ionplasmapistol</texPath>
      <drawSize>1.0</drawSize>
    </graphicData>
    <techLevel>Spacer</techLevel>
    <soundInteract>Interact_ChargeRifle</soundInteract>
    <recipeMaker>
      <researchPrerequisite>UFR_IonizedGasRefinement</researchPrerequisite>
      <skillRequirements>
        <Crafting>11</Crafting>
      </skillRequirements>
      <recipeUsers>
        <li>UFR_FabricationBench</li>
      </recipeUsers>
    </recipeMaker>
    <costList>
      <Steel>30</Steel>
      <Plasteel>25</Plasteel>
      <ComponentSpacer>5</ComponentSpacer>
      <Uranium>10</Uranium>
    </costList>
    <statBases>
      <WorkToMake>48000</WorkToMake>
      <Mass>1.4</Mass>
      <MarketValue>2100</MarketValue>
      <AccuracyTouch>0.85</AccuracyTouch>
      <AccuracyShort>0.78</AccuracyShort>
      <AccuracyMedium>0.55</AccuracyMedium>
      <AccuracyLong>0.30</AccuracyLong>
      <RangedWeapon_Cooldown>1.4</RangedWeapon_Cooldown>
    </statBases>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>UFR_Slug_IonPlasmaPistol</defaultProjectile>
        <warmupTime>0.55</warmupTime>
        <range>22.9</range>
        <soundCast>UFR_Bolt_Plasma</soundCast>
        <soundCastTail>GunTail_Light</soundCastTail>
        <muzzleFlashScale>9</muzzleFlashScale>
      </li>
    </verbs>
    <weaponTags>
      <li>UFR_UFSidearm</li>
    </weaponTags>
    <tools>
      <li>
        <label>grip</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
      <li>
        <label>barrel</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
    <thingSetMakerTags>
      <li>RewardStandardHighTech</li>
    </thingSetMakerTags>
    <tradeTags>
      <li>WeaponRanged</li>
    </tradeTags>
    <uiIconScale>1.05</uiIconScale>
  </ThingDef>

