  <ThingDef ParentName="BaseHumanMakeableGun" Name="UFR_IonPlasmaPistol">
    <defName>UFR_IonPlasmaPistol</defName>
    <label>Ion-Plasma Pistol</label>
    <description>An upgraded coil pistol that wraps its uranium Bolt in a sheath of ionized plasma before launch. The plasma sleeve melts and weakens armor a fraction of a second before the Bolt arrives, dramatically improving penetration without sacrificing the platform's compactness.</description>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>UFR/Things/Item/Equipment/ionplasmapistol</texPath>
      <drawSize>1.0</drawSize>
    </graphicData>
    <techLevel>Spacer</techLevel>
    <soundInteract>Interact_ChargeRifle</soundInteract>
    <recipeMaker>
      <researchPrerequisite>UFR_IonizedGasRefinement</researchPrerequisite>
      <skillRequirements>
        <Crafting>11</Crafting>
      </skillRequirements>
      <recipeUsers>
        <li>FabricationBench</li>
      </recipeUsers>
    </recipeMaker>
    <costList>
      <Steel>30</Steel>
      <Plasteel>25</Plasteel>
      <ComponentSpacer>5</ComponentSpacer>
      <Uranium>10</Uranium>
    </costList>
    <statBases>
      <WorkToMake>48000</WorkToMake>
      <Mass>1.4</Mass>
      <MarketValue>2100</MarketValue>
      <AccuracyTouch>0.85</AccuracyTouch>
      <AccuracyShort>0.78</AccuracyShort>
      <AccuracyMedium>0.55</AccuracyMedium>
      <AccuracyLong>0.30</AccuracyLong>
      <RangedWeapon_Cooldown>1.4</RangedWeapon_Cooldown>
    </statBases>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>UFR_Bolt_IonPlasmaPistol</defaultProjectile>
        <warmupTime>0.55</warmupTime>
        <range>21</range>
        <burstShotCount>3</burstShotCount>
        <ticksBetweenBurstShots>10</ticksBetweenBurstShots>
        <soundCast>UFR_Bolt_Plasma</soundCast>
        <soundCastTail>GunTail_Light</soundCastTail>
        <muzzleFlashScale>9</muzzleFlashScale>
      </li>
    </verbs>
    <weaponTags>
      <li>UFR_Plasma_Sidearm</li>
    </weaponTags>
    <tools>
      <li>
        <label>grip</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
      <li>
        <label>barrel</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
    <thingSetMakerTags>
      <li>RewardStandardHighTech</li>
    </thingSetMakerTags>
    <tradeTags>
      <li>WeaponRanged</li>
    </tradeTags>
    <uiIconScale>1.05</uiIconScale>
  </ThingDef>

