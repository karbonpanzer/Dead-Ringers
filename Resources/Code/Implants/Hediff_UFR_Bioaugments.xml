    </recipeMaker>
  </ThingDef>

  <!-- Vat-grown Arm -->
  <ThingDef ParentName="UFR_VatGrownPartBase">
    <defName>UFR_VatGrownArm</defName>
    <label>vat-grown arm</label>
    <description>An organic arm cultivated from lab-grown tissue. Denser musculature, reinforced bone, and engineered nerve fibers give it greater strength and dexterity than the natural arm it replaces.</description>
    <descriptionHyperlinks>
      <RecipeDef>UFR_InstallVatGrownArm</RecipeDef>
    </descriptionHyperlinks>
    <statBases>
      <MarketValue>2200</MarketValue>
      <Mass>2.0</Mass>
    </statBases>
    <costList>
      <UFR_LabGrownCulture>4</UFR_LabGrownCulture>
      <Neutroamine>4</Neutroamine>
      <Plasteel>3</Plasteel>
      <ComponentSpacer>1</ComponentSpacer>
    </costList>
    <recipeMaker>
      <workAmount>8000</workAmount>
    </recipeMaker>
  </ThingDef>

  <HediffDef ParentName="AddedBodyPartBase">
    <defName>UFR_VatGrownArm</defName>
    <label>vat-grown arm</label>
    <labelNoun>a vat-grown arm</labelNoun>
    <description>An installed vat-grown arm.</description>
    <descriptionHyperlinks>
      <ThingDef>UFR_VatGrownArm</ThingDef>
    </descriptionHyperlinks>
    <spawnThingOnRemoved>UFR_VatGrownArm</spawnThingOnRemoved>
    <addedPartProps>
      <solid>false</solid>
      <partEfficiency>1.35</partEfficiency>
      <betterThanNatural>true</betterThanNatural>
    </addedPartProps>
  </HediffDef>

  <RecipeDef ParentName="SurgeryInstallBodyPartArtificialBase">
    <defName>UFR_InstallVatGrownArm</defName>
    <label>install vat-grown arm</label>
    <description>Install a vat-grown arm.</description>
    <descriptionHyperlinks>
      <ThingDef>UFR_VatGrownArm</ThingDef>
      <HediffDef>UFR_VatGrownArm</HediffDef>
    </descriptionHyperlinks>
    <jobString>Installing vat-grown arm.</jobString>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>UFR_VatGrownArm</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>UFR_VatGrownArm</li>
      </thingDefs>
    </fixedIngredientFilter>
    <appliedOnFixedBodyParts>
      <li>Shoulder</li>
    </appliedOnFixedBodyParts>
    <addsHediff>UFR_VatGrownArm</addsHediff>
  </RecipeDef>

